<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 13+ runtime permission for posting notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Termux integration permission -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+ package visibility: without this, getPackageInfo/resolveService
         for com.termux throws NameNotFoundException and Termux is wrongly reported
         as not installed even though it is present on the device. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Universal MCP Bridge"
        android:theme="@style/Theme.MCPBridge"
        android:extractNativeLibs="true">

        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".McpServerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Stable explicit target for Termux RUN_COMMAND result PendingIntents. -->
        <receiver
            android:name=".TermuxResultReceiver"
            android:enabled="true"
            android:exported="true" />
    </application>
</manifest>
 